---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
import { stripTodo } from '../lib/todo.mjs';

interface Props {
  /** Page-specific title. Home passes nothing and gets the site title. */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of the social image (1200×630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  imageAlt = `${site.name}, ${site.role}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}, ${site.role}` : site.title;
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
// GitHub Pages serves every page as /path/, so canonical URLs end in a slash (matches the sitemap).
let path = Astro.url.pathname;
if (!path.endsWith('/') && !/\.[a-z0-9]+$/i.test(path)) path += '/';
const canonical = new URL(path, siteUrl).href;
const ogImage = new URL(image ?? url('/og-default.png'), siteUrl).href;
const cleanDescription = stripTodo(description).replace(/\s+/g, ' ').trim();
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content={site.name} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name}, ${site.role}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
