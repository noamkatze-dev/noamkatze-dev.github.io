---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Page-specific title. Home passes nothing and gets the site title. */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of the social image (1200×630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  imageAlt = `${site.name}, ${site.role}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}, ${site.role}` : site.title;
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
// GitHub Pages serves every page as /path/ (directory index), so canonical URLs
// always end in a slash, matching the sitemap.
let path = Astro.url.pathname;
if (!path.endsWith('/') && !/\.[a-z0-9]+$/i.test(path)) path += '/';
const canonical = new URL(path, siteUrl).href;
const ogImage = new URL(image ?? url('/og-default.png'), siteUrl).href;
const cleanDescription = description.replace(/\[TODO[^\]]*\]/g, '').replace(/\s+/g, ' ').trim();
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={site.name} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name}, ${site.role}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Subtle fade/slide-in on scroll. Elements are visible by default;
      // this only runs when JS is available and motion is allowed (see global.css).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Hairline under the header once the page scrolls.
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
