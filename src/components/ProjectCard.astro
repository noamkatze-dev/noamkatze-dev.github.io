---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import TodoText from './TodoText.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  /** The first card is above the fold: load its image eagerly. */
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const d = project.data;
---

<a class="project" href={url(`/work/${project.id}/`)}>
  {/* The title names the link; the cover is decorative here (full alt text is on the case-study page). */}
  <Media file={d.cover} alt="" note={d.coverNote} ratio="16 / 10" eager={eager} />
  <h3>{d.title}</h3>
  <p><TodoText text={d.summary} /></p>
</a>
