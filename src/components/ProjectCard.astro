---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import TodoText from './TodoText.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  /** The first card is above the fold on wide screens: load its image eagerly. */
  eager?: boolean;
}
const { project, index, eager = false } = Astro.props;
const d = project.data;
const number = index < 10 ? '0' + index : String(index);
const href = url('/work/' + project.id + '/');
---

<a class="card" href={href}>
  <div class="card-media">
    <Media
      file={d.cover}
      alt=""
      note={d.coverNote}
      ratio="4 / 3"
      eager={eager}
      sizes="(min-width: 1100px) 360px, (min-width: 700px) 50vw, 100vw"
    />
  </div>
  <div class="card-body">
    <div class="card-top">
      <span class="card-num" aria-hidden="true">{number}</span>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </div>
    <h3 class="card-title">{d.title}</h3>
    <p class="card-summary"><TodoText text={d.summary} /></p>
  </div>
</a>
