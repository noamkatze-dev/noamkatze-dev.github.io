---
/**
 * Opening section of a case study: eyebrow, headline, one or two sentences,
 * a short discipline line, the main links, then a large composition of real
 * project visuals. One shared type system, three layouts:
 *
 *   phones    → full-bleed brand band with a group of phone screens (Calcalist Next)
 *   screen    → one large interface shot on a measured grid, with numbered markers (Clarity)
 *   editorial → large wordmark, a gaze-data video and stills framed by a thin grid (250ms)
 *
 * Content lives in each project's frontmatter under `opening:`.
 */
import Media from './Media.astro';
import VideoMedia from './VideoMedia.astro';

interface Link {
  label: string;
  url: string;
  todo: boolean;
  filled: boolean;
}
interface Props {
  opening: {
    variant: 'phones' | 'screen' | 'editorial';
    eyebrow: string;
    headline: string;
    description: string;
    tags: string[];
    logo?: string;
    video?: { src: string; alt: string };
    images: { file: string; alt: string; caption?: string }[];
    steps: { label: string; x: number; y: number }[];
  };
  /** Project name, for screen readers when a wordmark stands in for it. */
  name: string;
  links: Link[];
}

const { opening: o, name, links } = Astro.props;
const variant = o.variant;
const heroClass = 'ph ph--' + variant;
const tagLine = o.tags.join(' · ');
const hasTags = o.tags.length > 0;
const isPhones = variant === 'phones';
const isScreen = variant === 'screen';
const isEditorial = variant === 'editorial';

// phones: the middle screen is the hero of the group
const phones = o.images.map((img, i) => ({ ...img, cls: 'ph-phone ph-phone--' + (i + 1) }));

// screen: first image, with numbered markers
const main = o.images[0];
const mainFile = main ? main.file : '';
const mainAlt = main ? main.alt : '';
const markers = o.steps.map((st, i) => ({
  n: i + 1,
  label: st.label,
  style: 'left: ' + st.x + '%; top: ' + st.y + '%',
}));

// editorial: video plus up to two stills with captions
const stills = o.images.slice(0, 2);
const hasVideo = Boolean(o.video);
const videoSrc = o.video ? o.video.src : '';
const videoAlt = o.video ? o.video.alt : '';
const logoFile = o.logo ?? '';
const hasLogo = Boolean(o.logo);
const logoAlt = name;
---

<header class={heroClass}>
  <div class="wrap ph-inner">
    <div class="ph-text">
      {
        isEditorial && hasLogo && (
          <h1 class="ph-logo">
            <Media file={logoFile} alt={logoAlt} sizes="(min-width: 1100px) 50vw, 90vw" eager />
          </h1>
        )
      }
      <p class="ph-eyebrow">{o.eyebrow}</p>
      {isEditorial && hasLogo ? <p class="ph-headline">{o.headline}</p> : <h1 class="ph-headline">{o.headline}</h1>}
      <div class="ph-side">
        <p class="ph-desc">{o.description}</p>
        {hasTags && <p class="ph-tags">{tagLine}</p>}
        {
          links.length > 0 && (
            <div class="buttons ph-buttons">
              {links.map((l) =>
                l.todo ? (
                  <span class="btn btn-outline" aria-disabled="true">
                    {l.label}: <mark class="todo">{l.url}</mark>
                  </span>
                ) : (
                  <a class={l.filled ? 'btn' : 'btn btn-outline'} href={l.url} target="_blank" rel="noopener noreferrer">
                    {l.label}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                ),
              )}
            </div>
          )
        }
      </div>
    </div>

    {
      isPhones && (
        <div class="ph-visual ph-phones">
          <span class="ph-bubble" aria-hidden="true" />
          {phones.map((p) => (
            <figure class={p.cls}>
              <Media file={p.file} alt={p.alt} sizes="(min-width: 1100px) 20vw, 30vw" eager />
            </figure>
          ))}
        </div>
      )
    }

    {
      isScreen && main && (
        <div class="ph-visual ph-screen">
          <div class="ph-board">
            <div class="ph-shot">
              <Media file={mainFile} alt={mainAlt} sizes="(min-width: 1100px) 84vw, 100vw" eager />
              {markers.map((m) => (
                <span class="ph-marker" style={m.style} aria-hidden="true">
                  {m.n}
                </span>
              ))}
            </div>
          </div>
          {markers.length > 0 && (
            <ol class="ph-steps">
              {markers.map((m) => (
                <li>
                  <span class="ph-step-n" aria-hidden="true">
                    {m.n}
                  </span>
                  {m.label}
                </li>
              ))}
            </ol>
          )}
        </div>
      )
    }

    {
      isEditorial && (
        <div class="ph-visual ph-editorial">
          {hasVideo && (
            <figure class="ph-main">
              <VideoMedia src={videoSrc} label={videoAlt} />
            </figure>
          )}
          {stills.length > 0 && (
            <div class="ph-stills">
              {stills.map((s) => (
                <figure>
                  <Media file={s.file} alt={s.alt} sizes="(min-width: 1100px) 28vw, 50vw" eager />
                  {s.caption && <figcaption>{s.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
</header>
