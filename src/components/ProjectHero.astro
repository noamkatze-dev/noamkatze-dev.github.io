---
/**
 * Opening section of a case study, the same layout on every project:
 * eyebrow, headline on the left; description, discipline line and links on the
 * right; then the real project visual on a light measured grid, with numbered
 * markers and a legend that explain what you are looking at.
 *
 *   one image      → a large interface shot, markers placed in % of the image (x, y)
 *   several images → a row of screens (phones: true for phone screens),
 *                    step N is placed on image N, again in % (x, y)
 *
 * `accent` colours the markers so each project keeps a touch of its own identity.
 * Content lives in each project's frontmatter under `opening:`.
 */
import Media from './Media.astro';

interface Link {
  label: string;
  url: string;
  todo: boolean;
  filled: boolean;
}
interface Props {
  opening: {
    eyebrow: string;
    headline: string;
    description: string;
    tags: string[];
    phones: boolean;
    accent?: string;
    images: { file: string; alt: string }[];
    steps: { label: string; x: number; y: number }[];
  };
  links: Link[];
}

const { opening: o, links } = Astro.props;
const tagLine = o.tags.join(' · ');
const hasTags = o.tags.length > 0;
const accentStyle = o.accent ? '--ph-accent: ' + o.accent : '';

const single = o.images.length === 1;
const main = o.images[0];
const mainFile = main ? main.file : '';
const mainAlt = main ? main.alt : '';
const markers = o.steps.map((st, i) => ({
  n: i + 1,
  label: st.label,
  style: 'left: ' + st.x + '%; top: ' + st.y + '%',
}));

// Several images: step i belongs to image i
const rowClass = o.phones ? 'ph-row ph-row--phones' : 'ph-row';
const rowStyle = '--n: ' + o.images.length;
const rowItems = o.images.map((img, i) => ({
  file: img.file,
  alt: img.alt,
  marker: markers[i],
}));
const rowSizes = o.phones ? '(min-width: 1100px) 18vw, 30vw' : '(min-width: 1100px) 28vw, 33vw';
---

<header class="ph" style={accentStyle}>
  <div class="wrap ph-inner">
    <div class="ph-text">
      <p class="ph-eyebrow">{o.eyebrow}</p>
      <h1 class="ph-headline">{o.headline}</h1>
      <div class="ph-side">
        <p class="ph-desc">{o.description}</p>
        {hasTags && <p class="ph-tags">{tagLine}</p>}
        {
          links.length > 0 && (
            <div class="buttons ph-buttons">
              {links.map((l) =>
                l.todo ? (
                  <span class="btn btn-outline" aria-disabled="true">
                    {l.label}: <mark class="todo">{l.url}</mark>
                  </span>
                ) : (
                  <a class={l.filled ? 'btn' : 'btn btn-outline'} href={l.url} target="_blank" rel="noopener noreferrer">
                    {l.label}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                ),
              )}
            </div>
          )
        }
      </div>
    </div>

    <div class="ph-visual">
      <div class="ph-board">
        {
          single && (
            <div class="ph-shot">
              <Media file={mainFile} alt={mainAlt} sizes="(min-width: 1100px) 84vw, 100vw" eager />
              {markers.map((m) => (
                <span class="ph-marker" style={m.style} aria-hidden="true">
                  {m.n}
                </span>
              ))}
            </div>
          )
        }
        {
          !single && (
            <div class={rowClass} style={rowStyle}>
              {rowItems.map((it) => (
                <div class="ph-shot">
                  <Media file={it.file} alt={it.alt} sizes={rowSizes} eager />
                  {it.marker && (
                    <span class="ph-marker" style={it.marker.style} aria-hidden="true">
                      {it.marker.n}
                    </span>
                  )}
                </div>
              ))}
            </div>
          )
        }
      </div>
      {
        markers.length > 0 && (
          <ol class="ph-steps">
            {markers.map((m) => (
              <li>
                <span class="ph-step-n" aria-hidden="true">
                  {m.n}
                </span>
                {m.label}
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </div>
</header>
