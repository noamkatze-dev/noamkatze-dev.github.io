---
import { site } from '../data/site';
import { url } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { href: url('/#work'), label: 'Work', current: path.startsWith('/work') },
  { href: url('/about/'), label: 'About', current: path.startsWith('/about') },
  { href: '#contact', label: 'Contact', current: false },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="name" href={url('/')}>{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
