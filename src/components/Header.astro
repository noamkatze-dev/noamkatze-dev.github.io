---
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  progress?: boolean;
}
const { progress = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { href: url('/about/'), label: 'About', current: path.startsWith('/about') },
  { href: url('/#work'), label: 'Projects', current: path.startsWith('/work') },
  { href: '#contact', label: 'Contact', current: false },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="name" href={url('/')}>{site.name}</a>
    <!-- Phones: the links fold into a full-screen menu. Shown only when ui.js runs. -->
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="ul" href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  {progress && <div class="progress" aria-hidden="true"><span class="progress-bar"></span></div>}
</header>
