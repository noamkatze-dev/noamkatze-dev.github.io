---
/**
 * Optimized image (AVIF/WebP via <Picture>, width/height set, lazy unless `eager`).
 * `file` is a path under src/assets/images/. If the file doesn't exist, a labelled
 * placeholder is shown in dev only; production renders nothing.
 */
import { Picture } from 'astro:assets';
import { findImage } from '../lib/images';
import { stripTodo } from '../lib/todo.mjs';

interface Props {
  file: string;
  alt: string;
  note?: string;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  file,
  alt,
  note,
  ratio = '16 / 10',
  sizes = '(min-width: 1216px) 1120px, calc(100vw - 48px)',
  eager = false,
  class: className,
} = Astro.props;

const img = await findImage(file);
const widths = img
  ? [...new Set([480, 800, 1120, 1600, 2240].filter((w) => w < img.width).concat(Math.min(img.width, 2400)))]
  : [];
const cleanAlt = stripTodo(alt);
---

{
  img ? (
    <Picture
      src={img}
      alt={cleanAlt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      class={className}
    />
  ) : (
    !import.meta.env.PROD && (
      <div class="placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Image placeholder: ${alt}`}>
        <code>src/assets/images/{file}</code>
        {note && <span>{note}</span>}
      </div>
    )
  )
}
