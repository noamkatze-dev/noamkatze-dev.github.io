---
/**
 * Optimized image OR a labelled placeholder frame.
 *
 * `file` is a path relative to src/assets/images/, e.g. "250ms/calibration.png".
 * The extension is ignored when matching, so exporting "calibration.jpg" instead
 * of ".png" still works. Drop the file in and the placeholder is replaced
 * automatically by a responsive AVIF/WebP <picture>.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  file: string;
  alt: string;
  /** What the image should show (only used by the placeholder). */
  note?: string;
  /** Placeholder aspect ratio, e.g. "16 / 10" (desktop) or "9 / 19.5" (phone). */
  ratio?: string;
  sizes?: string;
  eager?: boolean;
}

const {
  file,
  alt,
  note,
  ratio = '16 / 10',
  sizes = '(min-width: 80rem) 62rem, (min-width: 64rem) calc(100vw - 20rem), calc(100vw - 2rem)',
  eager = false,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{png,jpg,jpeg,webp,avif,gif,PNG,JPG,JPEG,WEBP}',
);
const stem = (p: string) => p.replace(/\.[^/.]+$/, '').toLowerCase();
const wanted = stem(`/src/assets/images/${file}`);
const key = Object.keys(images).find((k) => stem(k) === wanted);
const img = key ? (await images[key]()).default : null;

const widths = img
  ? [...new Set([480, 800, 1200, 1600, 2000].filter((w) => w < img.width).concat(Math.min(img.width, 2400)))]
  : [];
const cleanAlt = alt.replace(/\[TODO[^\]]*\]/g, '').trim();
---

{
  img ? (
    <Picture
      src={img}
      alt={cleanAlt || alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  ) : (
    <div class="placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Image placeholder: ${alt}`}>
      <code>src/assets/images/{file}</code>
      {note && <span>{note}</span>}
    </div>
  )
}
