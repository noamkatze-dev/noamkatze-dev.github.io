---
/**
 * Optimized image (AVIF/WebP via <Picture>, width/height set, lazy unless `eager`).
 * `file` is a path under src/assets/images/. Missing files show a labelled
 * placeholder in dev only; production renders nothing.
 * `zoom` wraps the image in a button that opens the lightbox (src/scripts/ui.js).
 */
import { Picture, getImage } from 'astro:assets';
import { findImage } from '../lib/images';
import { stripTodo } from '../lib/todo.mjs';

interface Props {
  file: string;
  alt: string;
  note?: string;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  zoom?: boolean;
  class?: string;
}

const {
  file,
  alt,
  note,
  ratio = '16 / 10',
  sizes = '(min-width: 960px) 880px, calc(100vw - 48px)',
  eager = false,
  zoom = false,
  class: className,
} = Astro.props;

const img = await findImage(file);
const dev = !import.meta.env.PROD;
const cleanAlt = stripTodo(alt);

const candidates = [320, 480, 640, 880, 1200, 1760];
const widths = img ? Array.from(new Set(candidates.filter((w) => w < img.width).concat([Math.min(img.width, 2000)]))) : [];

let full = '';
if (img && zoom) {
  const big = await getImage({ src: img, width: Math.min(img.width, 2000), format: 'webp' });
  full = big.src;
}
const zoomLabel = cleanAlt ? 'Enlarge image: ' + cleanAlt : 'Enlarge image';
const placeholderStyle = 'aspect-ratio: ' + ratio;
const placeholderLabel = 'Image placeholder: ' + alt;
const placeholderPath = 'src/assets/images/' + file;
---

{
  img && zoom && (
    <button type="button" class="zoom" data-full={full} aria-label={zoomLabel}>
      <Picture
        src={img}
        alt={cleanAlt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        class={className}
      />
    </button>
  )
}
{
  img && !zoom && (
    <Picture
      src={img}
      alt={cleanAlt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      class={className}
    />
  )
}
{
  !img && dev && (
    <div class="placeholder" style={placeholderStyle} role="img" aria-label={placeholderLabel}>
      <code>{placeholderPath}</code>
      {note && <span>{note}</span>}
    </div>
  )
}
