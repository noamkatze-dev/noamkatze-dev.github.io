---
/**
 * Self-hosted video, click-to-load: only the poster loads (preload="none"),
 * nothing plays until the visitor presses play. Never autoplays.
 * Files: public/videos/<src>.mp4 + <src>.jpg poster; sizes in src/data/videos.json.
 */
import videos from '../data/videos.json';
import { url } from '../lib/url';

interface Props {
  src: string;
  /** Accessible description of what the clip shows. */
  label: string;
  /** Narrow frame for phone recordings. */
  phone?: boolean;
}

const { src, label, phone = false } = Astro.props;
const meta = (videos as Record<string, { width: number; height: number; duration: number; audio: boolean }>)[src];
if (!meta) throw new Error('Video "' + src + '" is not in src/data/videos.json');
const videoSrc = url('/videos/' + src + '.mp4');
const posterSrc = url('/videos/' + src + '.jpg');
const wrapClass = phone ? 'video video--phone' : 'video';
---

<div class={wrapClass}>
  <video
    src={videoSrc}
    poster={posterSrc}
    width={meta.width}
    height={meta.height}
    controls
    playsinline
    preload="none"
    aria-label={label}
  ></video>
</div>
