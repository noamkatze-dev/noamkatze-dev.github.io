---
/**
 * Self-hosted video. Only the poster loads (preload="none") until it is needed.
 * Files: public/videos/<src>.mp4 + <src>.jpg poster; sizes in src/data/videos.json.
 *
 * No browser controls and no sound: the files have no audio track, and the
 * video is always muted. By default it plays in a loop while on screen
 * (src/scripts/ui.js starts and pauses it); clicking it pauses or plays.
 * With reduced motion, or autoplay={false}, it waits for a click.
 */
import videos from '../data/videos.json';
import { url } from '../lib/url';

interface Props {
  src: string;
  /** Accessible description of what the clip shows. */
  label: string;
  autoplay?: boolean;
}

const { src, label, autoplay = true } = Astro.props;
const meta = (videos as Record<string, { width: number; height: number; duration: number; audio: boolean }>)[src];
if (!meta) throw new Error('Video "' + src + '" is not in src/data/videos.json');
const videoSrc = url('/videos/' + src + '.mp4');
const posterSrc = url('/videos/' + src + '.jpg');
const ratio = 'aspect-ratio: ' + meta.width + ' / ' + meta.height;
---

<div class="video is-paused" style={ratio}>
  {
    autoplay ? (
      <video
        src={videoSrc}
        poster={posterSrc}
        width={meta.width}
        height={meta.height}
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        data-autoplay
        aria-label={label}
      ></video>
    ) : (
      <video
        src={videoSrc}
        poster={posterSrc}
        width={meta.width}
        height={meta.height}
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        aria-label={label}
      ></video>
    )
  }
  <button type="button" class="video-toggle" aria-label="Play or pause the video"></button>
</div>
