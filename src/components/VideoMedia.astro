---
/**
 * Self-hosted video. Only the poster loads (preload="none").
 * Files: public/videos/<src>.mp4 + <src>.jpg poster; sizes in src/data/videos.json.
 *
 * autoplay → plays muted and looped while on screen, like the Wix site
 *            (src/scripts/ui.js starts and pauses it; without JS, or with
 *            reduced motion, the normal controls stay).
 * otherwise → click to play.
 */
import videos from '../data/videos.json';
import { url } from '../lib/url';

interface Props {
  src: string;
  /** Accessible description of what the clip shows. */
  label: string;
  autoplay?: boolean;
}

const { src, label, autoplay = false } = Astro.props;
const meta = (videos as Record<string, { width: number; height: number; duration: number; audio: boolean }>)[src];
if (!meta) throw new Error('Video "' + src + '" is not in src/data/videos.json');
const videoSrc = url('/videos/' + src + '.mp4');
const posterSrc = url('/videos/' + src + '.jpg');
---

<div class="video">
  {
    autoplay ? (
      <video
        src={videoSrc}
        poster={posterSrc}
        width={meta.width}
        height={meta.height}
        controls
        muted
        loop
        playsinline
        preload="none"
        data-autoplay
        aria-label={label}
      ></video>
    ) : (
      <video
        src={videoSrc}
        poster={posterSrc}
        width={meta.width}
        height={meta.height}
        controls
        playsinline
        preload="none"
        aria-label={label}
      ></video>
    )
  }
</div>
