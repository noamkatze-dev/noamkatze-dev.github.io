---
/**
 * Self-hosted video. Only the poster loads (preload="none") until it is needed.
 * Files: public/videos/<src>.mp4 + <src>.jpg poster; sizes in src/data/videos.json.
 *
 * By default it plays muted and looped while on screen (src/scripts/ui.js starts
 * and pauses it). Clips with sound get a small "Sound on" button. Without JS, or
 * with reduced motion, the normal controls stay and nothing plays on its own.
 * autoplay={false} → click to play.
 */
import videos from '../data/videos.json';
import { url } from '../lib/url';

interface Props {
  src: string;
  /** Accessible description of what the clip shows. */
  label: string;
  autoplay?: boolean;
}

const { src, label, autoplay = true } = Astro.props;
const meta = (videos as Record<string, { width: number; height: number; duration: number; audio: boolean }>)[src];
if (!meta) throw new Error('Video "' + src + '" is not in src/data/videos.json');
const videoSrc = url('/videos/' + src + '.mp4');
const posterSrc = url('/videos/' + src + '.jpg');
const hasSound = autoplay && meta.audio;
const ratio = 'aspect-ratio: ' + meta.width + ' / ' + meta.height;
---

<div class="video" style={ratio}>
  {
    autoplay ? (
      <video
        src={videoSrc}
        poster={posterSrc}
        width={meta.width}
        height={meta.height}
        controls
        muted
        loop
        playsinline
        preload="none"
        data-autoplay
        aria-label={label}
      ></video>
    ) : (
      <video
        src={videoSrc}
        poster={posterSrc}
        width={meta.width}
        height={meta.height}
        controls
        playsinline
        preload="none"
        aria-label={label}
      ></video>
    )
  }
  {
    hasSound && (
      <button type="button" class="video-sound" data-sound hidden aria-pressed="false">
        Sound on
      </button>
    )
  }
</div>
