---
/**
 * Expandable gallery built on native <details>/<summary>:
 * keyboard operable (Enter/Space), announced as expandable by screen readers,
 * and images inside stay unloaded until it is opened (loading="lazy").
 *
 * <Gallery title="All app screens" count={15}>
 *   <Figure thumb file="..." alt="..." caption="..." />
 * </Gallery>
 */
interface Props {
  title: string;
  count?: number;
  open?: boolean;
}
const { title, count, open = false } = Astro.props;
---

<details class="gallery" open={open}>
  <summary>
    <span>{title}{count !== undefined && <span class="count">({count})</span>}</span>
    <span class="chev" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
    </span>
  </summary>
  <div class="gallery-grid">
    <slot />
  </div>
</details>
