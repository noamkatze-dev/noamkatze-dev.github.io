---
/**
 * Collapsed gallery on native <details>: keyboard operable, images load only
 * when opened (loading="lazy") and open in the lightbox. Omitted when empty.
 *
 * <Gallery title="All other app screens">
 *   <Figure thumb file="..." alt="..." caption="..." />
 * </Gallery>
 */
interface Props {
  title: string;
  /** Kept for compatibility; the real count is computed. */
  count?: number;
}
const { title } = Astro.props;
const html = await Astro.slots.render('default');
const count = html.split('<figure').length - 1;
const isWireframes = title.toLowerCase().includes('wireframe');
const label = isWireframes ? 'Show wireframes' : 'Show all screens';
const summary = label + ' (' + count + ')';
---

{
  count > 0 && (
    <details class="gallery">
      <summary>
        {summary}
        <span class="visually-hidden">: {title}</span>
      </summary>
      <div class="gallery-grid" set:html={html} />
    </details>
  )
}
