---
/**
 * Collapsed gallery on native <details>: keyboard operable, and images inside
 * only load when it is opened (loading="lazy"). Omitted when it has no images.
 *
 * <Gallery title="All other app screens">
 *   <Figure thumb file="..." alt="..." caption="..." />
 * </Gallery>
 */
interface Props {
  title: string;
  /** Kept for compatibility; the real count is computed. */
  count?: number;
}
const { title } = Astro.props;
const html = await Astro.slots.render('default');
const count = (html.match(/<figure/g) ?? []).length;
const label = /wireframe/i.test(title) ? 'Show wireframes' : 'Show all screens';
---

{
  count > 0 && (
    <details class="gallery">
      <summary>
        {label} ({count})<span class="visually-hidden">: {title}</span>
      </summary>
      <div class="gallery-grid" set:html={html} />
    </details>
  )
}
