---
/**
 * Collapsed gallery on native <details>: keyboard operable, images load only
 * when opened and open in the lightbox. Wireframe galleries sit on a black band.
 * Omitted when it has no images.
 *
 * <Gallery title="Wireframes">
 *   <Figure thumb phone file="..." alt="..." caption="..." />
 * </Gallery>
 */
interface Props {
  title: string;
  /** Kept for compatibility; the real count is computed. */
  count?: number;
}
const { title } = Astro.props;
const html = await Astro.slots.render('default');
const count = html.split('<figure').length - 1;
const isWireframes = title.toLowerCase().includes('wireframe');
const label = isWireframes ? 'Show wireframes' : 'Show all screens';
const summary = label + ' (' + count + ')';
const wrapClass = isWireframes ? 'gallery gallery-dark' : 'gallery';
---

{
  count > 0 && (
    <details class={wrapClass}>
      <summary>
        {summary}
        <span class="visually-hidden">: {title}</span>
      </summary>
      <div class="gallery-grid" set:html={html} />
    </details>
  )
}
