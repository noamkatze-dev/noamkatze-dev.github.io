---
/**
 * <Figure file="slug/name.png" alt="What is on screen" caption="Optional caption" />
 *   phone  → mobile screen styling (24px radius); use inside <Screens> rows
 *   thumb  → small image inside a gallery or grid
 * Caption can also be written as children (supports **bold** and links).
 * Every figure image opens in the lightbox. In production a figure whose
 * image doesn't exist renders nothing.
 */
import Media from '../Media.astro';
import TodoText from '../TodoText.astro';
import { findImage } from '../../lib/images';
import { isTodoOnly } from '../../lib/todo.mjs';

interface Props {
  file: string;
  alt: string;
  caption?: string;
  note?: string;
  ratio?: string;
  phone?: boolean;
  thumb?: boolean;
  eager?: boolean;
}
const { file, alt, caption, note, ratio, phone = false, thumb = false, eager = false } = Astro.props;
const exists = Boolean(await findImage(file));
const prod = import.meta.env.PROD;
const render = exists || !prod;
const hasSlot = Astro.slots.has('default');
const captionText = caption ?? '';
const showTextCaption = captionText !== '' && (!prod || !isTodoOnly(captionText));
const showSlotCaption = !showTextCaption && hasSlot;

let kind = 'shot';
if (phone) kind = 'phone';
if (thumb && !phone) kind = 'thumb';
let sizes = '(min-width: 960px) 880px, calc(100vw - 48px)';
if (phone) sizes = '(min-width: 700px) 260px, 70vw';
if (thumb && !phone) sizes = '(min-width: 700px) 260px, 50vw';
const phoneRatio = ratio ?? (phone ? '9 / 19.5' : undefined);
---

{
  render && (
    <figure class={kind}>
      <Media file={file} alt={alt} note={note} ratio={phoneRatio} sizes={sizes} eager={eager} zoom />
      {showTextCaption && (
        <figcaption>
          <TodoText text={captionText} />
        </figcaption>
      )}
      {showSlotCaption && (
        <figcaption>
          <slot />
        </figcaption>
      )}
    </figure>
  )
}
