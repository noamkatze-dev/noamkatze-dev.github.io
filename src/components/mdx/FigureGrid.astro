---
/** Lays out <Figure> children in a 2- or 3-column grid (1 column on mobile). */
interface Props {
  cols?: 2 | 3;
}
const { cols = 2 } = Astro.props;
const html = await Astro.slots.render('default');
const hasMedia =
  html.includes('<img') || html.includes('<video') || html.includes('class="placeholder"') || html.includes('class="embed"');
---

{hasMedia && <div class="figure-grid" data-cols={cols} set:html={html} />}
