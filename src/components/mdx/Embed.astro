---
/**
 * Click-to-load embed (YouTube, Vimeo, Figma, or any page that allows framing).
 * Nothing third-party loads until the visitor clicks (handled in src/scripts/ui.js).
 * In production an embed whose url is still a TODO renders nothing.
 */
import TodoText from '../TodoText.astro';
import { isTodoOnly } from '../../lib/todo.mjs';

interface Props {
  url: string;
  title: string;
  ratio?: string;
  description?: string;
  caption?: string;
  action?: string;
}

const { url, title, ratio = '16 / 9', description, caption, action } = Astro.props;
const todo = isTodoOnly(url);
const prod = import.meta.env.PROD;
const render = !(todo && prod);

let src = '';
let kind = 'site';
if (!todo) {
  try {
    const p = new URL(url);
    const host = p.hostname.replace('www.', '');
    const lastSegment = p.pathname.split('/').filter(Boolean).pop() ?? '';
    if (host === 'youtu.be' || host.endsWith('youtube.com')) {
      const id = host === 'youtu.be' ? lastSegment : (p.searchParams.get('v') ?? lastSegment);
      src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      kind = 'video';
    } else if (host.endsWith('vimeo.com')) {
      src = 'https://player.vimeo.com/video/' + lastSegment + '?autoplay=1&dnt=1';
      kind = 'video';
    } else if (host.endsWith('figma.com')) {
      src = 'https://www.figma.com/embed?embed_host=share&url=' + encodeURIComponent(url);
      kind = 'prototype';
    } else {
      src = url;
    }
  } catch {
    src = '';
  }
}
let label = 'Load live demo';
if (kind === 'video') label = 'Play video';
if (kind === 'prototype') label = 'Load prototype';
if (action) label = action;
const frameStyle = '--ratio: ' + ratio;
const hasCaption = Boolean(caption);
---

{
  render && (
    <figure class="embed shot">
      <div class="embed-frame" style={frameStyle} data-embed-src={src} data-embed-title={title}>
        <div class="embed-poster">
          <p>
            <strong>{title}</strong>
          </p>
          {todo && (
            <p>
              <TodoText text={url} />
            </p>
          )}
          {!todo && description && <p class="muted">{description}</p>}
          {!todo && (
            <button type="button" class="btn" data-embed-load>
              {label}
              <span class="visually-hidden">: {title}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </button>
          )}
        </div>
      </div>
      <figcaption>
        {hasCaption && <TodoText text={caption} />}
        {hasCaption && !todo && ' '}
        {!todo && (
          <a class="ul" href={url} target="_blank" rel="noopener noreferrer">
            Open in a new tab<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )}
      </figcaption>
    </figure>
  )
}
