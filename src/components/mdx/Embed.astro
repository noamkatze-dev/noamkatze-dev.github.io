---
/**
 * Click-to-load embed (YouTube, Vimeo, Figma, or any page that allows framing).
 * Nothing third-party loads until the visitor clicks. In production an embed
 * whose url is still a TODO renders nothing.
 */
import TodoText from '../TodoText.astro';
import { isTodoOnly } from '../../lib/todo.mjs';

interface Props {
  url: string;
  title: string;
  ratio?: string;
  description?: string;
  caption?: string;
  action?: string;
}

const { url, title, ratio = '16 / 9', description, caption, action } = Astro.props;
const todo = isTodoOnly(url);
const prod = import.meta.env.PROD;

function toEmbed(u: string): { src: string; kind: 'video' | 'prototype' | 'site' } {
  try {
    const p = new URL(u);
    const host = p.hostname.replace(/^www\./, '');
    if (host === 'youtu.be' || host.endsWith('youtube.com')) {
      const id = host === 'youtu.be' ? p.pathname.slice(1) : (p.searchParams.get('v') ?? p.pathname.split('/').filter(Boolean).pop());
      return { src: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`, kind: 'video' };
    }
    if (host.endsWith('vimeo.com')) {
      return { src: `https://player.vimeo.com/video/${p.pathname.split('/').filter(Boolean).pop()}?autoplay=1&dnt=1`, kind: 'video' };
    }
    if (host.endsWith('figma.com')) {
      return { src: `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(u)}`, kind: 'prototype' };
    }
    return { src: u, kind: 'site' };
  } catch {
    return { src: '', kind: 'site' };
  }
}
const { src, kind } = todo ? { src: '', kind: 'site' as const } : toEmbed(url);
const label = action ?? (kind === 'video' ? 'Play video' : kind === 'prototype' ? 'Load prototype' : 'Load live demo');
---

{
  !(todo && prod) && (
    <figure class="embed">
      <div class="embed-frame" style={`--ratio: ${ratio}`} data-embed-src={src || undefined} data-embed-title={title}>
        <div class="embed-poster">
          <p><strong>{title}</strong></p>
          {todo ? (
            <p>
              <TodoText text={url} />
            </p>
          ) : (
            <>
              {description && <p class="muted">{description}</p>}
              <button type="button" class="button" data-embed-load>
                {label}
                <span class="visually-hidden">: {title}</span>
              </button>
            </>
          )}
        </div>
      </div>
      <figcaption>
        {caption && <TodoText text={caption} />}
        {!todo && (
          <>
            {caption && ' '}
            <a href={url} target="_blank" rel="noopener noreferrer">
              Open in a new tab<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </>
        )}
      </figcaption>
    </figure>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-embed-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest<HTMLElement>('[data-embed-src]');
      const src = frame?.dataset.embedSrc;
      if (!frame || !src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = frame.dataset.embedTitle ?? 'Embedded content';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
