---
/**
 * Click-to-load embed: nothing third-party loads until the visitor asks for it,
 * so pages stay fast and Lighthouse stays green.
 *
 * <Embed url="https://youtu.be/xxxx" title="250ms promo video" />
 * <Embed url="https://www.figma.com/proto/..." title="App prototype" ratio="9 / 16" />
 * <Embed url="[TODO link]" title="Demo video" />   → shows a visible TODO frame
 *
 * Supported: YouTube, Vimeo, Figma (files/prototypes), any other https URL
 * that allows being framed (e.g. Base44 apps).
 */
import TodoText from '../TodoText.astro';
import { isTodo } from '../../lib/url';

interface Props {
  url: string;
  title: string;
  /** Aspect ratio of the frame, e.g. "16 / 9" (video) or "9 / 16" (phone prototype). */
  ratio?: string;
  /** Short line shown before loading. */
  description?: string;
  caption?: string;
  /** Label for the load button. */
  action?: string;
}

const { url, title, ratio = '16 / 9', description, caption, action } = Astro.props;
const todo = isTodo(url);

function toEmbed(u: string): { src: string; kind: string } {
  try {
    const parsed = new URL(u);
    const host = parsed.hostname.replace(/^www\./, '');
    if (host === 'youtu.be' || host.endsWith('youtube.com')) {
      const id =
        host === 'youtu.be'
          ? parsed.pathname.slice(1)
          : parsed.searchParams.get('v') ?? parsed.pathname.split('/').filter(Boolean).pop();
      return { src: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`, kind: 'video' };
    }
    if (host.endsWith('vimeo.com')) {
      const id = parsed.pathname.split('/').filter(Boolean).pop();
      return { src: `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`, kind: 'video' };
    }
    if (host.endsWith('figma.com')) {
      return {
        src: `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(u)}`,
        kind: 'prototype',
      };
    }
    return { src: u, kind: 'site' };
  } catch {
    return { src: '', kind: 'site' };
  }
}

const { src, kind } = todo ? { src: '', kind: 'site' } : toEmbed(url);
const buttonLabel = action ?? (kind === 'video' ? `Play: ${title}` : `Load interactive ${kind === 'prototype' ? 'prototype' : 'demo'}: ${title}`);
---

<figure class="embed" data-reveal>
  <div class="embed-frame" style={`--ratio: ${ratio}`} data-embed-src={src || undefined} data-embed-title={title}>
    <div class="embed-poster">
      {
        todo ? (
          <>
            <p class="embed-title">{title}</p>
            <p>
              <TodoText text={url} />
            </p>
          </>
        ) : (
          <>
            <button type="button" class="embed-play" data-embed-load aria-label={buttonLabel}>
              {kind === 'video' ? (
                <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M7 4.5v13l11-6.5z" fill="currentColor" /></svg>
              ) : (
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M5 11h12M12 5l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              )}
            </button>
            <p class="embed-title">{title}</p>
            {description && <p>{description}</p>}
            <p>Loads content from {new URL(url).hostname.replace(/^www\./, '')} on click.</p>
          </>
        )
      }
    </div>
  </div>
  <figcaption>
    {caption && <TodoText text={caption} />}
    {!todo && (
      <>
        {caption && ' '}
        <a href={url} target="_blank" rel="noopener noreferrer">Open in a new tab<span class="visually-hidden"> (opens in a new tab)</span> ↗</a>
      </>
    )}
  </figcaption>
</figure>

<script>
  function load(frame: HTMLElement) {
    const src = frame.dataset.embedSrc;
    if (!src) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = frame.dataset.embedTitle ?? 'Embedded content';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.replaceChildren(iframe);
    iframe.focus();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-embed-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest<HTMLElement>('[data-embed-src]');
      if (frame) load(frame);
    });
  });
</script>
