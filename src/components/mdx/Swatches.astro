---
/** Client colour palette: <Swatches colors={[{ hex: '#003BAB', name: 'Primary blue' }]} /> */
interface Props {
  colors: { hex: string; name?: string }[];
}
const { colors } = Astro.props;
---

<ul class="swatches">
  {
    colors.map((c) => (
      <li>
        <span class="swatch" style={`background: ${c.hex}`} aria-hidden="true" />
        {c.hex}
        {c.name && (
          <>
            <br />
            <span class="muted">{c.name}</span>
          </>
        )}
      </li>
    ))
  }
</ul>
