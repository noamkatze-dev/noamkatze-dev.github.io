---
/** Client colour palette: <Swatches colors={[{ hex: '#003BAB', name: 'Primary blue' }]} /> */
interface Props {
  colors: { hex: string; name?: string }[];
}
const { colors } = Astro.props;
const items = colors.map((c) => ({ hex: c.hex, name: c.name ?? '', style: 'background: ' + c.hex }));
---

<ul class="swatches">
  {
    items.map((c) => (
      <li>
        <span class="swatch" style={c.style} aria-hidden="true" />
        <span class="swatch-hex">{c.hex}</span>
        {c.name && <span class="muted">{c.name}</span>}
      </li>
    ))
  }
</ul>
