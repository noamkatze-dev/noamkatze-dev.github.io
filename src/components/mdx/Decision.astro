---
import TodoText from '../TodoText.astro';
import { isTodoOnly } from '../../lib/todo.mjs';

interface Props {
  title: string;
  choice: string;
  why: string;
  tradeoff: string;
}

const { title, choice, why, tradeoff } = Astro.props;
const prod = import.meta.env.PROD;
const show = (v: string) => !prod || !isTodoOnly(v);

const showTitle = show(title);
const rows = [
  { label: 'Decision', value: choice },
  { label: 'Why', value: why },
  { label: 'Trade-off', value: tradeoff },
].filter((r) => show(r.value));
const visible = showTitle || rows.length > 0;
const blocks = visible ? [true] : [];
---

{
  blocks.map(() => (
    <div class="decision">
      {showTitle && <h3><TodoText text={title} /></h3>}
      {rows.length > 0 && (
        <dl>
          {rows.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd><TodoText text={r.value} /></dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  ))
}
