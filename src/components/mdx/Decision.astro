---
/**
 * A key decision. Wrap several in <Decisions>; they are numbered automatically.
 * <Decision title="..." choice="What I decided" why="Why" tradeoff="What it cost" />
 * Fields that are still TODO are hidden in production; an all-TODO decision renders nothing.
 */
import TodoText from '../TodoText.astro';
import { isTodoOnly } from '../../lib/todo.mjs';

interface Props {
  title: string;
  choice: string;
  why: string;
  tradeoff: string;
}
const { title, choice, why, tradeoff } = Astro.props;
const prod = import.meta.env.PROD;
function show(v: string) {
  return !prod || !isTodoOnly(v);
}
const rows = [
  { label: 'Decision', value: choice },
  { label: 'Why', value: why },
  { label: 'Trade-off', value: tradeoff },
].filter((r) => show(r.value));
const showTitle = show(title);
const render = showTitle && rows.length > 0;
---

{
  render && (
    <li class="decision">
      <h3>
        <TodoText text={title} />
      </h3>
      <dl>
        {rows.map((r) => (
          <div>
            <dt>{r.label}</dt>
            <dd>
              <TodoText text={r.value} />
            </dd>
          </div>
        ))}
      </dl>
    </li>
  )
}
