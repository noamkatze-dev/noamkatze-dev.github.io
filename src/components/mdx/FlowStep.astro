---
/**
 * One step of a flow: large image or video on the left, title and text on the right.
 * <FlowStep title="Dashboard" video="slug/flow-1" alt="...">Markdown text</FlowStep>
 * Videos autoplay (muted, looped) while on screen, like the Wix site.
 * `n` is kept for compatibility and is not shown.
 */
import Media from '../Media.astro';
import VideoMedia from '../VideoMedia.astro';
import { bindLast } from '../../lib/todo.mjs';

interface Props {
  n?: number;
  title: string;
  /** Image under src/assets/images/ … */
  file?: string;
  /** …or a video under public/videos/ (no extension). */
  video?: string;
  alt: string;
  caption?: string;
  note?: string;
  ratio?: string;
}
const { title, file, video, alt, note, ratio } = Astro.props;
const heading = bindLast(title);
const imageFile = file ?? '';
const sizes = '(min-width: 1100px) 57vw, 100vw';
---

<li class="flow-item">
  <div class="flow-media">
    {video ? <VideoMedia src={video} label={alt} autoplay /> : <Media file={imageFile} alt={alt} note={note} ratio={ratio} sizes={sizes} zoom />}
  </div>
  <div class="flow-text">
    <h3>{heading}</h3>
    <slot />
  </div>
</li>
