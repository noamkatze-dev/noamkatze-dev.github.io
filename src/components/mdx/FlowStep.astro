---
/**
 * One step of a flow: large numeral, title, short text, then its image (or video).
 * <FlowStep n={1} title="Dashboard" file="slug/flow-1.png" alt="...">Markdown text</FlowStep>
 */
import Media from '../Media.astro';
import VideoMedia from '../VideoMedia.astro';
import { bindLast } from '../../lib/todo.mjs';

interface Props {
  n: number;
  title: string;
  /** Image under src/assets/images/ … */
  file?: string;
  /** …or a video under public/videos/ (no extension). */
  video?: string;
  alt: string;
  caption?: string;
  note?: string;
  ratio?: string;
}
const { n, title, file, video, alt, caption, note, ratio } = Astro.props;
const num = n < 10 ? '0' + n : String(n);
const heading = bindLast(title);
const imageFile = file ?? '';
---

<li class="flow-item">
  <span class="num" aria-hidden="true">{num}</span>
  <div class="flow-text">
    <h3>{heading}</h3>
    <slot />
  </div>
  <figure class="shot">
    {video ? <VideoMedia src={video} label={alt} /> : <Media file={imageFile} alt={alt} note={note} ratio={ratio} zoom />}
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</li>
