---
/**
 * One step of the main flow: numbered title, short text, then its image (or video).
 * <FlowStep n={1} title="Dashboard" file="slug/flow-1.png" alt="...">Markdown text</FlowStep>
 */
import Media from '../Media.astro';
import VideoMedia from '../VideoMedia.astro';

interface Props {
  n: number;
  title: string;
  /** Image under src/assets/images/ … */
  file?: string;
  /** …or a video under public/videos/ (no extension). */
  video?: string;
  alt: string;
  caption?: string;
  note?: string;
  ratio?: string;
}
const { title, file, video, alt, caption, note, ratio } = Astro.props;
---

<li>
  <div class="text">
    <h3>{title}</h3>
    <slot />
  </div>
  <figure>
    {video ? <VideoMedia src={video} label={alt} /> : <Media file={file ?? ''} alt={alt} note={note} ratio={ratio} />}
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</li>
