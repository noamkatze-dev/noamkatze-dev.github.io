---
/**
 * <Video src="calcalist-next/app-walkthrough" label="What the clip shows" phone autoplay radius={20} />
 *   phone    → 250px-wide phone recording in the text column
 *   autoplay → muted loop while on screen (default; autoplay={false} = click to play)
 *   radius   → rounded corners in px (at 1440px wide)
 * Files live in public/videos/<src>.mp4 with a <src>.jpg poster.
 */
import VideoMedia from '../VideoMedia.astro';
import TodoText from '../TodoText.astro';

interface Props {
  src: string;
  label: string;
  caption?: string;
  /** Kept for compatibility with older content. */
  mode?: 'loop' | 'player';
  phone?: boolean;
  autoplay?: boolean;
  radius?: number;
}
const { src, label, caption, phone = false, autoplay = true, radius = 0 } = Astro.props;
const kind = phone ? 'shot shot-phone' : 'shot';
const frameStyle = '--r: ' + radius;
---

<figure class={kind}>
  <div class="media-r" style={frameStyle}>
    <VideoMedia src={src} label={label} autoplay={autoplay} />
  </div>
  {
    caption && (
      <figcaption>
        <TodoText text={caption} />
      </figcaption>
    )
  }
</figure>
