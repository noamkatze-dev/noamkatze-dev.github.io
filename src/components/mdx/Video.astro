---
/**
 * <Video src="250ms/viewing-session" label="What the clip shows" caption="Short caption" />
 * Click-to-load: poster only, preload="none", never autoplays.
 * Files live in public/videos/<src>.mp4 with a <src>.jpg poster.
 */
import VideoMedia from '../VideoMedia.astro';
import TodoText from '../TodoText.astro';

interface Props {
  src: string;
  label: string;
  caption?: string;
  /** Kept for compatibility; every video now uses the click-to-play player. */
  mode?: 'loop' | 'player';
  phone?: boolean;
}
const { src, label, caption, phone } = Astro.props;
---

<figure>
  <VideoMedia src={src} label={label} phone={phone} />
  {
    caption && (
      <figcaption>
        <TodoText text={caption} />
      </figcaption>
    )
  }
</figure>
