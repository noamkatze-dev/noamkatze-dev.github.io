---
/**
 * One version of the design, laid out like a flow step (media left, text right).
 * `why` and `gaveUp` are optional extra lines; TODO-only lines are hidden in production.
 *
 * <IterationStage title="Initial Integration" video="..." alt="..." why="..." gaveUp="...">
 *   What this version was, in Markdown.
 * </IterationStage>
 */
import Media from '../Media.astro';
import VideoMedia from '../VideoMedia.astro';
import TodoText from '../TodoText.astro';
import { isTodoOnly, bindLast } from '../../lib/todo.mjs';

interface Props {
  n?: number;
  title: string;
  file?: string;
  video?: string;
  alt: string;
  note?: string;
  why?: string;
  gaveUp?: string;
}
const { title, file, video, alt, note, why, gaveUp } = Astro.props;
const prod = import.meta.env.PROD;
function show(v?: string) {
  if (!v) return false;
  return !prod || !isTodoOnly(v);
}
const showWhy = show(why);
const showGaveUp = show(gaveUp);
const heading = bindLast(title);
const imageFile = file ?? '';
const sizes = '(min-width: 1100px) 57vw, 100vw';
---

<li class="flow-item">
  <div class="flow-media">
    {video ? <VideoMedia src={video} label={alt} autoplay /> : <Media file={imageFile} alt={alt} note={note} sizes={sizes} zoom />}
  </div>
  <div class="flow-text">
    <h3>{heading}</h3>
    <slot />
    {
      showWhy && (
        <p class="flow-note">
          <strong>Why I changed it:</strong> <TodoText text={why} />
        </p>
      )
    }
    {
      showGaveUp && (
        <p class="flow-note">
          <strong>What I gave up:</strong> <TodoText text={gaveUp} />
        </p>
      )
    }
  </div>
</li>
