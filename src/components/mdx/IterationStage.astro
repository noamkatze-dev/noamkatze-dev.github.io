---
/**
 * One version in the iteration band. `why` and `gaveUp` are the most valuable
 * lines on the page — keep them honest. TODO-only lines are hidden in production.
 *
 * <IterationStage n={1} title="Ethical Insights" file="..." alt="..." why="..." gaveUp="...">
 *   What this version was, in Markdown.
 * </IterationStage>
 */
import Media from '../Media.astro';
import VideoMedia from '../VideoMedia.astro';
import TodoText from '../TodoText.astro';
import { isTodoOnly, bindLast } from '../../lib/todo.mjs';

interface Props {
  n: number;
  title: string;
  file?: string;
  video?: string;
  alt: string;
  note?: string;
  why?: string;
  gaveUp?: string;
}
const { n, title, file, video, alt, note, why, gaveUp } = Astro.props;
const prod = import.meta.env.PROD;
function show(v?: string) {
  if (!v) return false;
  return !prod || !isTodoOnly(v);
}
const showWhy = show(why);
const showGaveUp = show(gaveUp);
const num = n < 10 ? '0' + n : String(n);
const heading = bindLast(title);
const imageFile = file ?? '';
---

<li class="flow-item">
  <span class="num" aria-hidden="true">{num}</span>
  <div class="flow-text">
    <h3>{heading}</h3>
    <slot />
    {
      showWhy && (
        <p>
          <strong>Why I changed it:</strong> <TodoText text={why} />
        </p>
      )
    }
    {
      showGaveUp && (
        <p>
          <strong>What I gave up:</strong> <TodoText text={gaveUp} />
        </p>
      )
    }
  </div>
  <figure class="shot">
    {video ? <VideoMedia src={video} label={alt} /> : <Media file={imageFile} alt={alt} note={note} zoom />}
  </figure>
</li>
