---
/**
 * One version in the iteration list. `why` and `gaveUp` are the most valuable
 * lines on the page — keep them honest. TODO-only lines are hidden in production.
 *
 * <IterationStage n={1} title="Ethical Insights" file="..." alt="..." why="..." gaveUp="...">
 *   What this version was, in Markdown.
 * </IterationStage>
 */
import Media from '../Media.astro';
import VideoMedia from '../VideoMedia.astro';
import TodoText from '../TodoText.astro';
import { isTodoOnly } from '../../lib/todo.mjs';

interface Props {
  n: number;
  title: string;
  file?: string;
  video?: string;
  alt: string;
  note?: string;
  why?: string;
  gaveUp?: string;
}
const { title, file, video, alt, note, why, gaveUp } = Astro.props;
const prod = import.meta.env.PROD;
const show = (v?: string) => Boolean(v) && (!prod || !isTodoOnly(v));
---

<li>
  <div class="text">
    <h3>{title}</h3>
    <slot />
    {
      show(why) && (
        <p>
          <strong>Why I changed it:</strong> <TodoText text={why} />
        </p>
      )
    }
    {
      show(gaveUp) && (
        <p>
          <strong>What I gave up:</strong> <TodoText text={gaveUp} />
        </p>
      )
    }
  </div>
  <figure>
    {video ? <VideoMedia src={video} label={alt} /> : <Media file={file ?? ''} alt={alt} note={note} />}
  </figure>
</li>
