---
/**
 * Primary user: round photo with name and background, then two lists side by side.
 * <Persona title="Data Analyst" photo="slug/persona.jpg" photoAlt="..." background={["Line one", "Line two"]} workflow={[...]} goals={[...]} />
 * `jobs` is still accepted (shown as a third list) but the Wix layout uses a separate JTBD section.
 */
import TodoText from '../TodoText.astro';
import Media from '../Media.astro';

interface Props {
  title: string;
  photo?: string;
  photoAlt?: string;
  background?: string | string[];
  workflow?: string[];
  goals?: string[];
  jobs?: string[];
}
const { title, photo, photoAlt = '', background = [], workflow = [], goals = [], jobs = [] } = Astro.props;
const lists = [
  { label: 'Daily Workflow', items: workflow },
  { label: 'Goals', items: goals },
  { label: 'Jobs to be done', items: jobs },
].filter((l) => l.items.length > 0);
const bgLines = Array.isArray(background) ? background : [background];
const hasPhoto = Boolean(photo);
const photoFile = photo ?? '';
---

<div class="persona">
  <div class="persona-head">
    {
      hasPhoto && (
        <div class="persona-photo">
          <Media file={photoFile} alt={photoAlt} ratio="1 / 1" sizes="280px" />
        </div>
      )
    }
    <div>
      <h3 class="persona-name">{title}</h3>
      {
        bgLines.map((line) => (
          <p>
            <TodoText text={line} />
          </p>
        ))
      }
    </div>
  </div>
  <div class="persona-lists">
    {
      lists.map((l) => (
        <div>
          <p class="persona-label">{l.label}</p>
          <ul>
            {l.items.map((i) => (
              <li>
                <TodoText text={i} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>
