---
/**
 * Primary user, as plain text and lists.
 * <Persona title="Data Analyst" background="..." workflow={[...]} goals={[...]} jobs={[...]} />
 */
import TodoText from '../TodoText.astro';

interface Props {
  title: string;
  /** Kept for compatibility; persona photos are not shown in this design. */
  photo?: string;
  photoAlt?: string;
  background?: string;
  workflow?: string[];
  goals?: string[];
  jobs?: string[];
}
const { title, background, workflow = [], goals = [], jobs = [] } = Astro.props;
const lists = [
  { label: 'Daily workflow', items: workflow },
  { label: 'Goals', items: goals },
  { label: 'Jobs to be done', items: jobs },
].filter((l) => l.items.length);
---

<div class="persona">
  <div>
    <span class="label">Primary user</span>
    <h3>{title}</h3>
    {background && <p><TodoText text={background} /></p>}
  </div>
  {
    lists.map((l) => (
      <div>
        <span class="label">{l.label}</span>
        <ul>
          {l.items.map((i) => (
            <li>
              <TodoText text={i} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
