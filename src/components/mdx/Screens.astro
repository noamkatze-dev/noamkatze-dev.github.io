---
/**
 * Grid of phone screens, five per row on desktop, uppercase captions underneath.
 * `dark` puts the whole section on a full-width black band (the Wireframes section).
 *
 * <Screens>
 *   <Figure phone file="..." alt="..." caption="Splash" />
 * </Screens>
 */
interface Props {
  dark?: boolean;
  /** Kept for compatibility with older content. */
  label?: string;
  caption?: string;
}
const { dark = false } = Astro.props;
const html = await Astro.slots.render('default');
const hasMedia = html.includes('<img') || html.includes('class="placeholder"');
const kind = dark ? 'screens screens--dark' : 'screens';
---

{hasMedia && <div class={kind}><div class="screens-grid" set:html={html} /></div>}
