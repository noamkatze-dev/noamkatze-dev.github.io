---
/**
 * A row of mobile screens with a small label above and an optional caption below.
 * Desktop: 3–4 screens per row. Mobile: a horizontal scroll-snap strip.
 *
 * <Screens label="Connect" caption="...">
 *   <Figure phone file="..." alt="..." caption="Scan" />
 * </Screens>
 */
import TodoText from '../TodoText.astro';

interface Props {
  label?: string;
  caption?: string;
}
const { label, caption } = Astro.props;
const html = await Astro.slots.render('default');
const hasMedia = html.includes('<img') || html.includes('class="placeholder"');
---

{
  hasMedia && (
    <div class="screens">
      {label && <p class="label">{label}</p>}
      <div class="screens-row" set:html={html} />
      {caption && (
        <p class="screens-caption">
          <TodoText text={caption} />
        </p>
      )}
    </div>
  )
}
