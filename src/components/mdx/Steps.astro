---
/** Work process: one row of uppercase steps joined by short lines. <Steps items={['Research', 'Wireframes']} /> */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ol class="process">
  {
    items.map((item) => (
      <li>
        <span>{item}</span>
      </li>
    ))
  }
</ol>
