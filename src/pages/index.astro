---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, hero, aboutTeaser } from '../data/site';
import { url } from '../lib/url';
import { findImage } from '../lib/images';
import { bindLast } from '../lib/todo.mjs';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
// The original round portrait, used as-is (no crop or zoom).
const portrait = await findImage('about/portrait.jpg');
const portraitAlt = 'Portrait of ' + site.name;
const support = bindLast(hero.support);
const paragraphs = aboutTeaser.map((p) => bindLast(p));
const aboutHref = url('/about/');
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    {
      portrait && (
        <div class="hero-photo">
          <Picture
            src={portrait}
            alt={portraitAlt}
            widths={[240, 400, 640, 1000]}
            sizes="(min-width: 1100px) 20vw, 220px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title">{hero.headline}</h1>
      <p class="hero-support">{support}</p>
      <div class="buttons hero-buttons">
        <a class="btn" href="#work">View projects <span class="arrow" aria-hidden="true">↓</span></a>
      </div>
    </div>
    <a class="scroll-cue" href="#work">
      <span class="visually-hidden">Scroll to the projects</span>
      <svg width="37" height="20" viewBox="0 0 37 20" fill="none" aria-hidden="true"><path d="M1 1.5l17.5 17L36 1.5" stroke="currentColor" stroke-width="1.3"></path></svg>
    </a>
  </section>

  <section class="wrap home-section home-work" id="work" aria-labelledby="work-title">
    <h2 id="work-title">Projects</h2>
    <ul class="projects">
      {
        projects.map((p, i) => (
          <li>
            <ProjectCard project={p} eager={i === 0} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap home-section" id="about" aria-labelledby="about-title">
    <h2 id="about-title">About</h2>
    <div class="home-text">
      {paragraphs.map((p) => <p>{p}</p>)}
      <p class="home-more">
        <a class="btn btn-outline" href={aboutHref}>
          More about me <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</Base>
