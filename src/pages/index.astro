---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, hero, aboutTeaser } from '../data/site';
import { url } from '../lib/url';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="label hero-eyebrow">{site.name} · {site.role}</p>
    <h1 id="hero-title">{hero.headline}</h1>
    <p class="lede">{hero.support}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#work">Selected work <span class="arrow" aria-hidden="true">↓</span></a>
      <a class="btn" href="#contact">Contact</a>
    </div>
  </section>

  <section class="section container" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <p class="label">{projects.length} case studies</p>
    </div>
    <ul class="project-grid">
      {
        projects.map((p, i) => (
          <li>
            <ProjectCard project={p} featured={i === 0} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="about-title">
    <div class="about-teaser">
      <h2 id="about-title">About</h2>
      <div>
        <p>{aboutTeaser}</p>
        <a class="text-link" href={url('/about/')}>More about me, my background and skills <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
