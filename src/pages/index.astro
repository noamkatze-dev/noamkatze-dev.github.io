---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, hero, homeAbout, homeSkills } from '../data/site';
import { findImage } from '../lib/images';
import { bindLast } from '../lib/todo.mjs';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const portrait = await findImage('about/portrait-square.jpg');
const portraitAlt = 'Portrait of ' + site.name;
const support = bindLast(hero.support);
const paragraphs = homeAbout.map((p) => bindLast(p));
const skillRows = homeSkills.map((g) => ({ label: g.label, list: g.items.join(' · ') }));
// Thumbnail proportions of the three cards on the Wix home page
const ratios = ['463 / 255', '394 / 254', '394 / 195'];
const cards = projects.map((p, i) => ({ project: p, ratio: ratios[i] ?? '16 / 10', eager: i === 0 }));
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    {
      portrait && (
        <div class="hero-photo">
          <Picture
            src={portrait}
            alt={portraitAlt}
            width={640}
            height={640}
            widths={[200, 320, 640]}
            sizes="(min-width: 1100px) 20vw, 200px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title">{hero.headline}</h1>
      <p class="hero-support">{support}</p>
    </div>
    <a class="scroll-cue" href="#about">
      <span class="visually-hidden">Scroll to About</span>
      <svg width="37" height="20" viewBox="0 0 37 20" fill="none" aria-hidden="true"><path d="M1 1.5l17.5 17L36 1.5" stroke="currentColor" stroke-width="1.3"></path></svg>
    </a>
  </section>

  <section class="wrap home-section" id="about" aria-labelledby="about-title">
    <h2 id="about-title">About</h2>
    <div class="home-text">
      {paragraphs.map((p) => <p>{p}</p>)}
      <dl class="home-skills">
        {
          skillRows.map((g) => (
            <>
              <dt>{g.label}</dt>
              <dd>{g.list}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap home-section" id="work" aria-labelledby="work-title">
    <h2 id="work-title">Projects</h2>
    <ul class="projects">
      {
        cards.map((c) => (
          <li>
            <ProjectCard project={c.project} ratio={c.ratio} eager={c.eager} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
