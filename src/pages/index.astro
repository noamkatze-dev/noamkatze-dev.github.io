---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, hero, aboutTeaser, skills } from '../data/site';
import { url } from '../lib/url';
import { findImage } from '../lib/images';
import { bindLast } from '../lib/todo.mjs';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const portrait = await findImage('about/portrait-square.jpg');
const portraitAlt = 'Portrait of ' + site.name;
const support = bindLast(hero.support);
const teaser = bindLast(aboutTeaser);
const skillRows = skills.map((g) => ({ group: g.group, list: bindLast(g.items.join(' · ')) }));
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    {
      portrait && (
        <div class="hero-photo">
          <Picture
            src={portrait}
            alt={portraitAlt}
            width={640}
            height={640}
            widths={[180, 320, 640]}
            sizes="(min-width: 768px) 320px, 180px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title">{hero.headline}</h1>
      <p class="hero-support">{support}</p>
    </div>
    <a class="scroll-cue" href="#about">
      <span class="visually-hidden">Scroll to About</span>
      <svg width="28" height="14" viewBox="0 0 28 14" fill="none" aria-hidden="true"><path d="M1 1l13 12L27 1" stroke="currentColor" stroke-width="1.2"></path></svg>
    </a>
  </section>

  <section class="wrap split" id="about" aria-labelledby="about-title">
    <h2 id="about-title" class="split-label">About</h2>
    <div class="split-body">
      <p>{teaser}</p>
      <dl class="skill-list">
        {
          skillRows.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.list}</dd>
            </div>
          ))
        }
      </dl>
      <p><a class="ul" href={url('/about/')}>More about me, my background and skills</a></p>
    </div>
  </section>

  <section class="wrap split" id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="split-label">Projects</h2>
    <ul class="projects">
      {
        projects.map((p, i) => (
          <li>
            <ProjectCard project={p} eager={i === 0} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
