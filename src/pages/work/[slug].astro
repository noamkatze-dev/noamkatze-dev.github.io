---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import TodoText from '../../components/TodoText.astro';
import { mdxComponents } from '../../components/mdx';
import { url } from '../../lib/url';
import { findImage } from '../../lib/images';
import { isTodoOnly } from '../../lib/todo.mjs';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const prod = import.meta.env.PROD;
const shown = (v?: string) => Boolean(v) && (!prod || !isTodoOnly(v));

// Social image: the cover, cropped to 1200×630.
const coverImg = await findImage(d.cover);
const ogImage = coverImg ? (await getImage({ src: coverImg, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src : undefined;

const links = [...d.links.filter((l) => l.primary), ...d.links.filter((l) => !l.primary)];
const tools = d.tools.filter((t) => shown(t));
const meta = [
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Timeframe', value: d.duration },
].filter((m) => shown(m.value));
---

<Base title={d.title} description={d.summary} image={ogImage} imageAlt={d.coverAlt} type="article">
  <article>
    <header class="cs-head wrap">
      <p class="small muted"><TodoText text={d.context} /> · {d.year}</p>
      <h1>{d.title}</h1>
      {d.tagline && <p class="lead">{d.tagline}</p>}
      <p class="lead muted"><TodoText text={d.summary} /></p>

      {
        links.some((l) => shown(l.url)) && (
          <div class="buttons">
            {links.map((l) =>
              isTodoOnly(l.url) ? (
                !prod && (
                  <span class="button" aria-disabled="true">
                    {l.label}: <mark class="todo">{l.url}</mark>
                  </span>
                )
              ) : (
                <a class="button" href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label} ↗<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              ),
            )}
          </div>
        )
      }

      <dl class="meta">
        {
          meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>
                <TodoText text={m.value} />
              </dd>
            </div>
          ))
        }
        {
          tools.length > 0 && (
            <div>
              <dt>Tools</dt>
              <dd>
                <ul>
                  {tools.map((t) => (
                    <li>
                      <TodoText text={t} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          d.deliverables && (
            <div class="meta-full">
              <dt>Deliverables</dt>
              <dd>{d.deliverables.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      <figure class="cs-cover">
        <Media file={d.cover} alt={d.coverAlt} note={d.coverNote} ratio="16 / 9" eager />
      </figure>
    </header>

    <div class="wrap prose">
      <Content components={mdxComponents} />
    </div>
  </article>

  {
    next && next.id !== project.id && (
      <nav class="wrap next" aria-label="Next project">
        <p class="small muted">Next project</p>
        <a href={url(`/work/${next.id}/`)}>{next.data.title} →</a>
      </nav>
    )
  }
</Base>
