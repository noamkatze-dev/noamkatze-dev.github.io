---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import TodoText from '../../components/TodoText.astro';
import { mdxComponents } from '../../components/mdx';
import { url } from '../../lib/url';
import { findImage } from '../../lib/images';
import { isTodoOnly, stripTodo } from '../../lib/todo.mjs';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i + 1, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, index, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const prod = import.meta.env.PROD;

function shown(v?: string) {
  if (!v) return false;
  return !prod || !isTodoOnly(v);
}

// Social image: the cover, cropped to 1200×630.
const coverImg = await findImage(d.cover);
let ogImage: string | undefined = undefined;
if (coverImg) {
  const og = await getImage({ src: coverImg, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
  ogImage = og.src;
}

const ordered = d.links.filter((l) => l.primary).concat(d.links.filter((l) => !l.primary));
const links = ordered.map((l, i) => ({
  label: l.label,
  url: l.url,
  todo: isTodoOnly(l.url),
  filled: i === 0,
}));
const visibleLinks = links.filter((l) => !l.todo || !prod);
const tools = d.tools.filter((t) => shown(t)).map((t) => stripTodo(t));
const toolsText = prod ? tools.join(', ') : d.tools.join(', ');
const deliverablesText = (d.deliverables ?? []).join(', ');
const meta = [
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Timeframe', value: d.duration },
].filter((m) => shown(m.value));
const nextHref = next ? url('/work/' + next.id + '/') : '';
const showNext = Boolean(next) && next.id !== project.id;
---

<Base title={d.title} description={d.summary} image={ogImage} imageAlt={d.coverAlt} type="article" progress>
  <article>
    <header class="cs-head wrap">
      <h1>{d.title}</h1>
      {d.tagline && <p class="cs-tagline">{d.tagline}</p>}
      <a class="scroll-cue" href="#overview">
        <span class="visually-hidden">Scroll to overview</span>
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" aria-hidden="true"><path d="M1 1l13 12L27 1" stroke="currentColor" stroke-width="1.2"></path></svg>
      </a>
      <figure class="cs-cover">
        <Media file={d.cover} alt={d.coverAlt} note={d.coverNote} ratio="16 / 9" eager zoom />
      </figure>
    </header>

    <section class="wrap split cs-intro" id="overview" aria-labelledby="overview-title">
      <h2 id="overview-title" class="split-label"><TodoText text={d.context} /></h2>
      <div class="split-body">
        <p class="lead"><TodoText text={d.summary} /></p>

        <dl class="meta">
          {
            meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>
                  <TodoText text={m.value} />
                </dd>
              </div>
            ))
          }
          {
            tools.length > 0 && (
              <div>
                <dt>Tools</dt>
                <dd>{toolsText}</dd>
              </div>
            )
          }
          {
            d.deliverables && (
              <div>
                <dt>Deliverables</dt>
                <dd>{deliverablesText}</dd>
              </div>
            )
          }
          <div>
            <dt>Year</dt>
            <dd>{d.year}</dd>
          </div>
        </dl>

        {
          visibleLinks.length > 0 && (
            <div class="buttons">
              {visibleLinks.map((l) =>
                l.todo ? (
                  <span class="btn btn-outline" aria-disabled="true">
                    {l.label}: <mark class="todo">{l.url}</mark>
                  </span>
                ) : (
                  <a class={l.filled ? 'btn' : 'btn btn-outline'} href={l.url} target="_blank" rel="noopener noreferrer">
                    {l.label}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                ),
              )}
            </div>
          )
        }
      </div>
    </section>

    <div class="wrap prose">
      <Content components={mdxComponents} />
    </div>
  </article>

  {
    showNext && (
      <nav class="wrap next" aria-label="Next project">
        <p class="label">Next project</p>
        <a class="next-link" href={nextHref}>
          {next.data.title} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </nav>
    )
  }
</Base>
