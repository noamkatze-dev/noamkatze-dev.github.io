---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import TodoText from '../../components/TodoText.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import { mdxComponents } from '../../components/mdx';
import { findImage } from '../../lib/images';
import { url } from '../../lib/url';
import { isTodoOnly, stripTodo } from '../../lib/todo.mjs';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  // The last project's "next" link goes back to the first one.
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const prod = import.meta.env.PROD;

// Social image: the cover, cropped to 1200×630.
const coverImg = await findImage(d.cover);
let ogImage: string | undefined = undefined;
if (coverImg) {
  const og = await getImage({ src: coverImg, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
  ogImage = og.src;
}

// Page title (used by the fallback header and for screen readers)
const heading = d.shortTitle ?? d.title;

// Overview row: role, team, timeframe, tools. TODO-only values are hidden on the live site.
function shown(v?: string) {
  if (!v) return false;
  return !prod || !isTodoOnly(v);
}
const tools = d.tools.filter((t) => shown(t)).map((t) => (prod ? stripTodo(t) : t));
const showRole = shown(d.role);
const showOutcome = shown(d.outcome);
const meta = [
  { label: 'Team', value: d.team },
  { label: 'Timeframe', value: d.duration },
  { label: 'Tools', value: tools.join(', ') },
  { label: 'Context', value: d.context },
].filter((m) => shown(m.value));
const ordered = d.links.filter((l) => l.primary).concat(d.links.filter((l) => !l.primary));
const links = ordered
  .map((l, i) => ({ label: l.label, url: l.url, todo: isTodoOnly(l.url), filled: i === 0 }))
  .filter((l) => !l.todo || !prod);

// Next project
const nextHref = url('/work/' + next.id + '/');
const nextName = next.data.shortTitle ?? next.data.title;
const nextImage = next.data.card ?? next.data.cover;
const showNext = next.id !== project.id;

// New opening section (eyebrow, headline, visual). Without it, the older hero is used.
const opening = d.opening;
const hasOpening = Boolean(opening);
const overviewLinks = hasOpening ? [] : links;
---

<Base title={d.title} description={d.summary} image={ogImage} imageAlt={d.coverAlt} type="article">
  <article>
    {opening && <ProjectHero opening={opening} links={links} />}
    {
      !hasOpening && (
        <header class="cs-hero wrap">
          <h1 class="cs-title">{heading}</h1>
        </header>
      )
    }

    <section class="wrap cs-overview" id="content" aria-label="Project overview">
      {!hasOpening && <p class="cs-summary">{d.summary}</p>}
      {
        (showRole || showOutcome) && (
          <dl class="cs-key">
            {showRole && (
              <div>
                <dt>My role</dt>
                <dd>
                  <TodoText text={d.role} />
                </dd>
              </div>
            )}
            {showOutcome && (
              <div>
                <dt>Outcome</dt>
                <dd>
                  <TodoText text={d.outcome ?? ''} />
                </dd>
              </div>
            )}
          </dl>
        )
      }
      <dl class="cs-meta">
        {
          meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>
                <TodoText text={m.value} />
              </dd>
            </div>
          ))
        }
      </dl>
      {
        overviewLinks.length > 0 && (
          <div class="buttons">
            {overviewLinks.map((l) =>
              l.todo ? (
                <span class="btn btn-outline" aria-disabled="true">
                  {l.label}: <mark class="todo">{l.url}</mark>
                </span>
              ) : (
                <a class={l.filled ? 'btn' : 'btn btn-outline'} href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ),
            )}
          </div>
        )
      }
    </section>

    <div class="wrap prose">
      <Content components={mdxComponents} />
    </div>
  </article>

  {
    showNext && (
      <nav class="wrap next" aria-label="Next project">
        <a class="next-link" href={nextHref}>
          <span class="next-text">
            <span class="eyebrow">Next project</span>
            <span class="next-title">
              {nextName} <span class="arrow" aria-hidden="true">→</span>
            </span>
          </span>
          <span class="next-media">
            <Media file={nextImage} alt="" sizes="(min-width: 1100px) 30vw, 100vw" />
          </span>
        </a>
      </nav>
    )
  }
</Base>
