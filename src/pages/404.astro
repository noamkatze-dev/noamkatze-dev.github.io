---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="hero wrap">
    <h1>This page doesn't exist.</h1>
    <p class="lead">The link may be old, or the page moved.</p>
    <p style="margin-top: var(--s-4)"><a href={url('/')}>Back to home</a> · <a href={url('/#work')}>See selected work</a></p>
  </section>
</Base>
