---
import Base from '../layouts/Base.astro';
import TodoText from '../components/TodoText.astro';
import Media from '../components/Media.astro';
import { site, about, skills, experience, education, recognition } from '../data/site';
import { url } from '../lib/url';
import { isTodoOnly } from '../lib/todo.mjs';
import type { TimelineItem } from '../data/site';

// In production, drop entries that are still mostly placeholders.
const ready = (items: TimelineItem[]) => (import.meta.env.PROD ? items.filter((i) => !isTodoOnly(i.org)) : items);

const groups: { id: string; title: string; intro?: string; items: TimelineItem[] }[] = [
  {
    id: 'experience',
    title: 'Experience',
    intro:
      'Five years of military service taught me to run complex systems with many stakeholders, under real constraints. It is the same muscle I use in product design.',
    items: ready(experience),
  },
  { id: 'education', title: 'Education', items: ready(education) },
];
---

<Base
  title="About"
  description={`About ${site.name}: product designer, B.Des University of Haifa, former IDF procurement team leader. Skills, education and experience.`}
>
  <section class="hero wrap" aria-labelledby="about-h1">
    <h1 id="about-h1">Clarity is the whole point.</h1>
  </section>

  <div class="wrap rows">
    <section class="row" aria-labelledby="bio-title">
      <h2 id="bio-title">Background</h2>
      <div class="bio">
        <div class="portrait">
          <Media
            file="about/portrait-crop.jpg"
            alt={`Black-and-white portrait of ${site.name} in a dark blazer, arms folded, against a plain light wall.`}
            ratio="4 / 5"
            sizes="200px"
            eager
          />
        </div>
        {about.map((p) => <p>{p}</p>)}
        <div class="buttons">
          <a class="button" href={url(site.cv)} download>Download CV (PDF)</a>
        </div>
      </div>
    </section>

    {
      groups.map((g) => (
        <section class="row section" aria-labelledby={`${g.id}-title`}>
          <h2 id={`${g.id}-title`}>{g.title}</h2>
          <div>
            {g.intro && <p style="margin-bottom: var(--s-3)">{g.intro}</p>}
            <ul class="entries">
              {g.items.map((item) => (
                <li>
                  <span class="period">
                    <TodoText text={item.period} />
                  </span>
                  <strong>{item.title}</strong>
                  <br />
                  <span class="muted">
                    <TodoText text={item.org} />
                  </span>
                  {item.detail && (
                    <p>
                      <TodoText text={item.detail} />
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <section class="row section" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills and tools</h2>
      <ul class="entries">
        {
          skills.map((g) => (
            <li>
              <span class="period">{g.group}</span>
              {g.items.join(', ')}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row section" aria-labelledby="recognition-title">
      <h2 id="recognition-title">Recognition</h2>
      <ul class="entries">
        {
          recognition.map((r) => (
            <li>
              <strong>{r.title}</strong>
              <br />
              <span class="muted">{r.detail}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
