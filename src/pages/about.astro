---
import Base from '../layouts/Base.astro';
import TodoText from '../components/TodoText.astro';
import Media from '../components/Media.astro';
import { site, about, skills, experience, education, recognition } from '../data/site';
import { url } from '../lib/url';
import type { TimelineItem } from '../data/site';

const groups: { id: string; title: string; intro?: string; items: TimelineItem[] }[] = [
  {
    id: 'experience',
    title: 'Experience',
    intro:
      'Five years of military service taught me to run complex systems with many stakeholders, under real constraints. It is the same muscle I use in product design.',
    items: experience,
  },
  { id: 'education', title: 'Education', items: education },
];
---

<Base
  title="About"
  description={`About ${site.name}: product designer, B.Des University of Haifa, former IDF procurement team leader. Skills, education and experience.`}
>
  <section class="hero container" aria-labelledby="about-h1">
    <p class="label hero-eyebrow">About</p>
    <h1 id="about-h1">Clarity is the whole point.</h1>
  </section>

  <section class="section container" aria-labelledby="bio-title">
    <div class="about-grid">
      <div>
        <h2 id="bio-title">Background</h2>
        <div class="portrait" style="margin-top: var(--space-l)">
          <Media file="about/portrait.jpg" alt={`Portrait of ${site.name}`} ratio="1 / 1" sizes="(min-width: 56rem) 22rem, 80vw" eager />
        </div>
      </div>
      <div class="prose-lg">
        {about.map((p) => <p>{p}</p>)}
        <p style="margin-top: var(--space-l)">
          <a class="btn" href={url(site.cv)} download>Download CV (PDF)</a>
        </p>
      </div>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="section container" aria-labelledby={`${g.id}-title`}>
        <div class="about-grid">
          <div>
            <h2 id={`${g.id}-title`}>{g.title}</h2>
            {g.intro && (
              <p class="lede" style="margin-top: var(--space-s); font-size: var(--step-0)">
                {g.intro}
              </p>
            )}
          </div>
          <ol class="timeline">
            {g.items.map((item) => (
              <li>
                <span class="period">
                  <TodoText text={item.period} />
                </span>
                <div>
                  <h3>{item.title}</h3>
                  <p class="org">
                    <TodoText text={item.org} />
                  </p>
                  {item.detail && (
                    <p class="detail">
                      <TodoText text={item.detail} />
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))
  }

  <section class="section container" aria-labelledby="skills-title">
    <div class="about-grid">
      <h2 id="skills-title">Skills and tools</h2>
      <div class="skill-groups">
        {
          skills.map((g) => (
            <div>
              <h3>{g.group}</h3>
              <ul class="tags">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="recognition-title">
    <div class="about-grid">
      <h2 id="recognition-title">Recognition</h2>
      <div>
        {
          recognition.map((r) => (
            <div class="recognition">
              <h3>{r.title}</h3>
              <p class="org" style="margin-top: var(--space-3xs); color: var(--color-muted)">
                {r.detail}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
